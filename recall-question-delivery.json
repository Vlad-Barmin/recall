    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text;\n\n// Модель часто оборачивает JSON в markdown-блок — снимаем обёртку\nconst cleaned = raw\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Модель вернула не JSON. Получено: ' + cleaned.slice(0, 200));\n}\n\n// Проверяем, что оба поля на месте и не пустые\nfor (const field of ['question', 'reference']) {\n  if (typeof parsed[field] !== 'string' || parsed[field].trim() === '') {\n    throw new Error('Отсутствует или пустое поле: ' + field);\n  }\n}\n\nreturn [{\n  json: {\n    question: parsed.question.trim(),\n    reference: parsed.reference.trim(),\n  }\n}];"
      },
